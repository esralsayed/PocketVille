
# ==========================================
# PocketVille - Unity .gitignore
# ==========================================

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity generated files
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated metadata
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt

# Unity asset store tools
/[Aa]ssets/AssetStoreTools*

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
.gradle/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Unity caches
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Autogenerated test coverage
/[Cc]overage/

# Unity generated backups
*.bak
*.tmp
